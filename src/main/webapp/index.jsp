<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Myntra Clone</title>
    <link rel="stylesheet" href="style.css">
    <!-- Font Awesome for Navbar Icons -->
    <link rel="stylesheet" href="https://cloudflare.com">
</head>
<body>

    <!-- Header / Navbar Section -->
    <header class="navbar">
        <div class="nav-logo">
            <!-- Simplified CSS Myntra Logo placeholder -->
            <div class="logo-box">M</div>
        </div>
        
        <nav class="nav-links">
            <a href="#" class="nav-item">MEN</a>
            <a href="#" class="nav-item">WOMEN</a>
            <a href="#" class="nav-item">KIDS</a>
            <a href="#" class="nav-item">HOME & LIVING</a>
            <a href="#" class="nav-item">BEAUTY</a>
            <a href="#" class="nav-item">STUDIO <sup>New</sup></a>
        </nav>

        <div class="search-bar">
            <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" placeholder="Search for products, brands and more">
        </div>

        <div class="nav-actions">
            <div class="action-item">
                <i class="fa-regular fa-user"></i>
                <span>Profile</span>
            </div>
            <div class="action-item">
                <i class="fa-regular fa-heart"></i>
                <span>Wishlist</span>
            </div>
            <div class="action-item">
                <i class="fa-solid fa-bag-shopping"></i>
                <span>Bag</span>
            </div>
        </div>
    </header>

    <!-- Main Content Section -->
    <main class="container">
        <h2 class="section-title">DEALS OF THE DAY</h2>
        
        <!-- Product Grid -->
        <div class="product-grid">
            <!-- Sample Product Card -->
            <div class="product-card">
                <div class="product-image">
                    <img src="https://placeholder.com" alt="Product Image">
                </div>
                <div class="product-details">
                    <h3 class="brand-name">Roadster</h3>
                    <p class="product-name">Men Cotton Pure Shirt</p>
                    <div class="price-box">
                        <span class="current-price">₹599</span>
                        <span class="original-price">₹1499</span>
                        <span class="discount-tag">(60% OFF)</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>
</html>

